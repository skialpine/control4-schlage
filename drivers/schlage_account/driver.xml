  <manufacturer>Schlage</manufacturer>
  <model>Schlage Account</model>
  <small image_source="c4z">icons/composer_16.png</small>
  <large image_source="c4z">icons/composer_32.png</large>
  <creator>control4-schlage contributors</creator>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 control4-schlage contributors. AGPL-3.0.</copyright>
  <created>01/01/2026 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <minimum_os_version>3.4.1</minimum_os_version>
  <composer_categories>
    <category>Other</category>
  </composer_categories>
  <conditionals/>
  <events/>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Driver Settings</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>LIST</type>
        <default>3 - Info</default>
        <items>
          <item>0 - Fatal</item>
          <item>1 - Error</item>
          <item>2 - Warning</item>
          <item>3 - Info</item>
          <item>4 - Debug</item>
          <item>5 - Trace</item>
          <item>6 - Ultra</item>
        </items>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <property><name>Credentials</name><type>STRING</type><default>Not configured</default><readonly>true</readonly><tooltip>Saved credentials are encrypted. Entry fields clear after saving.</tooltip></property>
      <property><name>Last Session Renewal</name><type>STRING</type><default>Not yet observed</default><readonly>true</readonly><tooltip>Controller local time of the last successful refresh-token renewal during this driver run.</tooltip></property>
      <property><name>Schlage Email</name><type>STRING</type><default/><password>true</password><tooltip>Enter email first. Saved securely; field clears after entry.</tooltip></property>
      <property><name>Schlage Password</name><type>STRING</type><default/><password>true</password><tooltip>Enter password after email, then run Sign In. Field clears after entry.</tooltip></property>
      <property><name>Discovered Locks</name><type>STRING</type><default/><readonly>true</readonly></property>
      <property><name>Polling Interval (seconds)</name><type>RANGED_INTEGER</type><default>30</default><minimum>15</minimum><maximum>3600</maximum><tooltip>Account read interval. Locks go offline after 120 seconds without a successful read.</tooltip></property>
      <property><name>Polling Status</name><type>STRING</type><default>Waiting for sign in</default><readonly>true</readonly></property>
      <property><name>Crypto Status</name><type>STRING</type><default/><readonly>true</readonly></property>
      <property><name>SRP Public Time (ms)</name><type>STRING</type><default/><readonly>true</readonly></property>
      <property><name>SRP Proof Time (ms)</name><type>STRING</type><default/><readonly>true</readonly></property>
      <property><name>Battery Alerts</name><type>LABEL</type><default>Battery Alerts</default></property>
      <property><name>Low Battery Push Notifications</name><type>LIST</type><default>Off</default><items><item>Off</item><item>On</item></items><tooltip>Automatically send daily Control4 push alerts for every low-battery lock on this account. No manual notification-agent programming is required.</tooltip></property>
      <property><name>Battery Alert Time</name><type>STRING</type><default>09:00</default><tooltip>Account-wide controller local time in 24-hour HH:MM format. Alerts use the first fresh qualifying observation at or after this time.</tooltip></property>
      <property><name>Battery Alert Threshold (%)</name><type>RANGED_INTEGER</type><default>20</default><minimum>0</minimum><maximum>100</maximum><tooltip>Alert when a supplied percentage is at or below this value, or when Schlage reports low battery. Applies to all locks on this account.</tooltip></property>
      <property><name>Battery Alert Status</name><type>STRING</type><default>Waiting for fresh battery data</default><readonly>true</readonly></property>
      <property><name>Battery Push Status</name><type>STRING</type><default>Not submitted</default><readonly>true</readonly></property>
      <property><name>Last Battery Alert</name><type>STRING</type><default>Never</default><readonly>true</readonly><tooltip>Controller local time of the last daily event or automatic push attempt. Does not confirm phone delivery.</tooltip></property>
      <property><name>Updates</name><type>LABEL</type><default>Updates</default></property>
      <property><name>Automatic Updates</name><type>LIST</type><default>On</default><items><item>Off</item><item>On</item></items><tooltip>Shared across Schlage drivers. Checks published GitHub releases every six hours.</tooltip></property>
      <property><name>Update Channel</name><type>LIST</type><default>Stable</default><items><item>Stable</item><item>Prerelease</item></items><tooltip>Prerelease includes development releases. Stable excludes them.</tooltip></property>
      <property><name>Update Status</name><type>STRING</type><default>Not checked</default><readonly>true</readonly></property>
      <property><name>Last Update Check</name><type>STRING</type><default>Not yet checked</default><readonly>true</readonly><tooltip>Controller local time, including its time zone.</tooltip></property>
    </properties>
    <actions>
      <action><name>Sign In</name><command>Sign_In</command></action>
      <action><name>Sign Out</name><command>Sign_Out</command></action>
      <action><name>Discover Locks</name><command>Discover_Locks</command></action>
      <action><name>Renew Session</name><command>Renew_Session</command></action>
      <action><name>Check Crypto</name><command>Check_Crypto</command></action>
      <action><name>Check for Updates</name><command>Check_for_Updates</command></action>
      <action><name>Diagnostics Snapshot</name><command>Diagnostics_Snapshot</command></action>
      <action><name>Test Battery Alert</name><command>Test_Battery_Alert</command></action>
    </actions>
  </config>
  <capabilities/>
  <connections/>
</devicedata>
